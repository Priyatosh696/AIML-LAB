      "source": [
        "from collections import deque\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Store graph using adjacency list\n",
        "graph = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['D', 'E'],\n",
        "    'C': ['F'],\n",
        "    'D': [],\n",
        "    'E': [],\n",
        "    'F': []\n",
        "}\n",
        "\n",
        "\n",
        "# 2. BFS Traversal\n",
        "def BFS(graph, start):\n",
        "    visited = []\n",
        "    queue = deque([start])\n",
        "\n",
        "    while queue:\n",
        "        node = queue.popleft()\n",
        "\n",
        "        if node not in visited:\n",
        "            visited.append(node)\n",
        "            queue.extend(graph[node])\n",
        "\n",
        "    return visited\n",
        "\n",
        "\n",
        "# 3. DFS Traversal\n",
        "def DFS(graph, start, visited=None):\n",
        "    if visited is None:\n",
        "        visited = []\n",
        "\n",
        "    visited.append(start)\n",
        "\n",
        "    for node in graph[start]:\n",
        "        if node not in visited:\n",
        "            DFS(graph, node, visited)\n",
        "\n",
        "    return visited\n",
        "\n",
        "\n",
        "# Perform BFS and DFS\n",
        "bfs_order = BFS(graph, 'A')\n",
        "dfs_order = DFS(graph, 'A')\n",
        "\n",
        "# 4. Print traversal orders\n",
        "print(\"BFS Traversal:\", \" -> \".join(bfs_order))\n",
        "print(\"DFS Traversal:\", \" -> \".join(dfs_order))\n",
        "\n",
        "\n",
        "# Function to draw tree\n",
        "def draw_tree(order, title):\n",
        "    positions = {\n",
        "        'A': (0, 3),\n",
        "        'B': (-1, 2),\n",
        "        'C': (1, 2),\n",
        "        'D': (-1.5, 1),\n",
        "        'E': (-0.5, 1),\n",
        "        'F': (1, 1)\n",
        "    }\n",
        "\n",
        "    edges = [\n",
        "        ('A', 'B'),\n",
        "        ('A', 'C'),\n",
        "        ('B', 'D'),\n",
        "        ('B', 'E'),\n",
        "        ('C', 'F')\n",
        "    ]\n",
        "\n",
        "    plt.figure(figsize=(7, 5))\n",
        "\n",
        "    # Draw edges\n",
        "    for u, v in edges:\n",
        "        x1, y1 = positions[u]\n",
        "        x2, y2 = positions[v]\n",
        "        plt.plot([x1, x2], [y1, y2], 'k-')\n",
        "\n",
        "    # Draw nodes with visit order\n",
        "    for i, node in enumerate(order, 1):\n",
        "        x, y = positions[node]\n",
        "        plt.scatter(x, y, s=1500)\n",
        "        plt.text(x, y, f\"{node}\\n({i})\",\n",
        "                 ha='center', va='center', fontsize=12)\n",
        "\n",
        "    plt.title(title)\n",
        "    plt.axis('off')\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# Draw BFS tree\n",
        "draw_tree(bfs_order, \"BFS Traversal Order\")\n",
        "\n",
        "# Draw DFS tree\n",
        "draw_tree(dfs_order, \"DFS Traversal Order\")"
      ],
