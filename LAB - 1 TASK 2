      "source": [
        "from collections import deque\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Capacities\n",
        "A = 4\n",
        "B = 3\n",
        "\n",
        "# BFS function\n",
        "def water_jug_bfs():\n",
        "    start = (0, 0)\n",
        "    queue = deque([(start, [])])\n",
        "    visited = {start}\n",
        "\n",
        "    while queue:\n",
        "        (a, b), path = queue.popleft()\n",
        "\n",
        "        # Goal condition\n",
        "        if a == 2 or b == 2:\n",
        "            return path + [(a, b)]\n",
        "\n",
        "        next_states = []\n",
        "\n",
        "        # 1. Fill Jug A\n",
        "        next_states.append(((A, b), \"Fill Jug A\"))\n",
        "\n",
        "        # 2. Fill Jug B\n",
        "        next_states.append(((a, B), \"Fill Jug B\"))\n",
        "\n",
        "        # 3. Empty Jug A\n",
        "        next_states.append(((0, b), \"Empty Jug A\"))\n",
        "\n",
        "        # 4. Empty Jug B\n",
        "        next_states.append(((a, 0), \"Empty Jug B\"))\n",
        "\n",
        "        # 5. Pour A -> B\n",
        "        amount = min(a, B - b)\n",
        "        next_states.append(\n",
        "            ((a - amount, b + amount), \"Pour A -> B\")\n",
        "        )\n",
        "\n",
        "        # 6. Pour B -> A\n",
        "        amount = min(b, A - a)\n",
        "        next_states.append(\n",
        "            ((a + amount, b - amount), \"Pour B -> A\")\n",
        "        )\n",
        "\n",
        "        for state, operation in next_states:\n",
        "            if state not in visited:\n",
        "                visited.add(state)\n",
        "                queue.append((state, path + [(a, b, operation)]))\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "# Get solution\n",
        "solution = water_jug_bfs()\n",
        "\n",
        "# Print solution\n",
        "print(\"Minimum Steps:\\n\")\n",
        "\n",
        "for i, state in enumerate(solution):\n",
        "    if len(state) == 3:\n",
        "        a, b, operation = state\n",
        "        print(f\"Step {i}: {operation} -> ({a}, {b})\")\n",
        "    else:\n",
        "        a, b = state\n",
        "        print(f\"Step {i}: Goal Reached -> ({a}, {b})\")\n",
        "\n",
        "\n",
        "# ---------------- Matplotlib Visualization ----------------\n",
        "\n",
        "states = []\n",
        "\n",
        "for item in solution:\n",
        "    if len(item) == 3:\n",
        "        states.append((item[0], item[1]))\n",
        "    else:\n",
        "        states.append(item)\n",
        "\n",
        "x = list(range(len(states)))\n",
        "jug_a = [state[0] for state in states]\n",
        "jug_b = [state[1] for state in states]\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.plot(x, jug_a, marker='o', label=\"Jug A (4L)\")\n",
        "plt.plot(x, jug_b, marker='s', label=\"Jug B (3L)\")\n",
        "\n",
        "plt.xticks(x)\n",
        "plt.xlabel(\"Step\")\n",
        "plt.ylabel(\"Amount of Water (Litres)\")\n",
        "plt.title(\"Water Jug Problem - BFS Solution\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "\n",
        "plt.show()"
